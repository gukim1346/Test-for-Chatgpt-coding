# Files and directories to omit when deploying with gcloud app deploy
# You can add custom entries below. The defaults listed here mirror the
# behaviour of gcloud's autogenerated ignore file.

.gcloudignore
.git
.gitignore
!Dockerfile
__pycache__/
*.pyc
*.pyo
*.pyd
.env
venv/
ENV/
.build/
node_modules/

