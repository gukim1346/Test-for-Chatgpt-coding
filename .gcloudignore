# Files and directories to omit when deploying with gcloud commands.
# This mirrors the defaults from gcloud's autogenerated ignore file and
# ensures our deployment descriptors (Dockerfile, app.yaml, cloudbuild.yaml)
# remain in the upload so Cloud Build can find them.

.gcloudignore
.git
.gitignore

# Retain deployment descriptors in the Cloud Build context
!/Dockerfile
!/app.yaml
!/cloudbuild.yaml

__pycache__/
*.pyc
*.pyo
*.pyd
.env
venv/
ENV/
.build/
node_modules/

